# --- Storage (required) ----------------------------------------------------
# Create a free Upstash Redis database at https://console.upstash.com
# then copy its "REST URL" and "REST Token" here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard ---------------------------------------------------------
# Password for /admin (the dashboard). If unset, /admin shows "not configured".
# The password can also be changed from the dashboard itself — a scrypt hash
# is then stored in Redis and overrides this value.
ADMIN_PASSWORD=

# --- App --------------------------------------------------------------------
# Port for local development
PORT=3000

# Optional: the public base URL of your deployed site, e.g.
# https://my-site.example.com
# Set this in production so card share links always point at the real domain.
# When unset, links are built from the request's Host header, but only loopback
# hosts (localhost / 127.0.0.1 / ::1) are accepted — anything else fails loudly
# instead of building a link controlled by whoever made the request.
PUBLIC_BASE_URL=
