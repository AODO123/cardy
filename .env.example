# --- Storage (required) ----------------------------------------------------
# Create a free Upstash Redis database at https://console.upstash.com
# then copy its "REST URL" and "REST Token" here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard ---------------------------------------------------------
# Password for /admin (the dashboard). If unset, /admin shows "not configured".
# The password can also be changed from the dashboard itself — a sha-256 hash
# is then stored in Redis and overrides this value.
ADMIN_PASSWORD=

# --- Optional link shortener ------------------------------------------------
# Bitly access token (optional). Get one at:
# https://app.bitly.com/settings/api/  (or your Bitly org's settings)
# Without it, cards still work — you just get the full link.
BITLY_ACCESS_TOKEN=

# --- App --------------------------------------------------------------------
# Port for local development
PORT=3000

# Optional: the public base URL of your deployed site, e.g.
# https://my-site.example.com
# If unset, card links are built from the incoming request
# (which is perfect for local dev).
PUBLIC_BASE_URL=
